
@model MoneyMate.ViewModels.TransactionFilterViewModel

@{
    ViewData["Title"] = "Transactions";
}

<div class="container mt-4">

    <h2>Transactions</h2>

    <p>Manage your income and expenses.</p>

    <!-- Add Transaction -->
    <a asp-controller="Transaction"
       asp-action="Create"
       class="btn btn-success mb-4">
        Add Transaction
    </a>

    <!-- Filter Transactions -->
    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title">Filter Transactions</h5>

            <form asp-controller="Transaction"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- Month -->
                    <div class="col-12 col-md-6 col-xl-3">

                        <label for="selectedMonth"
                               class="form-label">
                            Month
                        </label>

                        <select name="selectedMonth"
                                id="selectedMonth"
                                class="form-select">

                            <option value="">All months</option>

                            @for (int month = 1; month <= 12; month++)
                            {
                                if (Model.SelectedMonth == month)
                                {
                                    <option value="@month" selected>
                                        @System.Globalization.CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetMonthName(month)
                                    </option>
                                }
                                else
                                {
                                    <option value="@month">
                                        @System.Globalization.CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetMonthName(month)
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Year -->
                    <div class="col-12 col-md-6 col-xl-3">

                        <label for="selectedYear"
                               class="form-label">
                            Year
                        </label>

                        <select name="selectedYear"
                                id="selectedYear"
                                class="form-select">

                            <option value="">All years</option>

                            @foreach (var year in Model.Years)
                            {
                                if (Model.SelectedYear == year)
                                {
                                    <option value="@year" selected>
                                        @year
                                    </option>
                                }
                                else
                                {
                                    <option value="@year">
                                        @year
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Category -->
                    <div class="col-12 col-md-6 col-xl-3">

                        <label for="selectedCategory"
                               class="form-label">
                            Category
                        </label>

                        <select name="selectedCategory"
                                id="selectedCategory"
                                class="form-select">

                            <option value="">All categories</option>

                            @foreach (var category in Model.Categories)
                            {
                                if (Model.SelectedCategory == category)
                                {
                                    <option value="@category" selected>
                                        @category
                                    </option>
                                }
                                else
                                {
                                    <option value="@category">
                                        @category
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Type -->
                    <div class="col-12 col-md-6 col-xl-3">

                        <label for="selectedType"
                               class="form-label">
                            Type
                        </label>

                        <select name="selectedType"
                                id="selectedType"
                                class="form-select">

                            <option value="">All types</option>

                            @if (Model.SelectedType == "Income")
                            {
                                <option value="Income" selected>
                                    Income
                                </option>
                            }
                            else
                            {
                                <option value="Income">Income</option>
                            }

                            @if (Model.SelectedType == "Expense")
                            {
                                <option value="Expense" selected>
                                    Expense
                                </option>
                            }
                            else
                            {
                                <option value="Expense">Expense</option>
                            }

                        </select>

                    </div>

                </div>

                <!-- Filter buttons -->
                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Filter
                    </button>

                    <a asp-controller="Transaction"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Clear Filters
                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- Financial Summary -->
    <div class="row mb-4">

        <!-- Total Income -->
        <div class="col-md-4 mb-3">

            <div class="card border-success h-100">

                <div class="card-body">

                    <h5 class="card-title text-success">
                        Total Income
                    </h5>

                    <h3 class="card-text">
                        @Model.TotalIncome.ToString("N2") kr
                    </h3>

                </div>

            </div>

        </div>

        <!-- Total Expenses -->
        <div class="col-md-4 mb-3">

            <div class="card border-danger h-100">

                <div class="card-body">

                    <h5 class="card-title text-danger">
                        Total Expenses
                    </h5>

                    <h3 class="card-text">
                        @Model.TotalExpenses.ToString("N2") kr
                    </h3>

                </div>

            </div>

        </div>

        <!-- Balance -->
        <div class="col-md-4 mb-3">

            <div class="card border-primary h-100">

                <div class="card-body">

                    <h5 class="card-title text-primary">
                        Balance
                    </h5>

                    <h3 class="card-text @(Model.Balance < 0 ? "text-danger" : "text-success")">
                        @Model.Balance.ToString("N2") kr
                    </h3>

                </div>

            </div>

        </div>

    </div>

    <!-- Transactions Table -->
    <h4>Transactions</h4>

    @if (Model.Transactions.Any())
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered">

                <thead class="table-dark">

                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var transaction in Model.Transactions)
                    {
                        <tr>

                            <!-- Date -->
                            <td>
                                @transaction.Date.ToString(
                                    "dd MMM yyyy",
                                    System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                            </td>

                            <!-- Description -->
                            <td>@transaction.Description</td>

                            <!-- Category -->
                            <td>@transaction.Category</td>

                            <!-- Type -->
                            <td>
                                @if (transaction.Type == "Income")
                                {
                                    <span class="badge bg-success">
                                        Income
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Expense
                                    </span>
                                }
                            </td>

                            <!-- Amount -->
                            <td class="@(transaction.Type == "Income" ? "text-success" : "text-danger")">
                                @(transaction.Type == "Income" ? "+" : "-")@transaction.Amount.ToString("N2") kr
                            </td>

                            <!-- Actions -->
                            <td>

                                <div class="d-flex gap-2">

                                    <!-- Edit -->
                                    <a asp-controller="Transaction"
                                       asp-action="Edit"
                                       asp-route-id="@transaction.Id"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <!-- Delete -->
                                    <form asp-controller="Transaction"
                                          asp-action="Delete"
                                          asp-route-id="@transaction.Id"
                                          method="post">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this transaction?');">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No transactions found.
        </div>
    }

</div>
