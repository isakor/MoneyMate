
@model IEnumerable<MoneyMate.Models.Budget>

@{
    ViewData["Title"] = "Budgets";
}

<div class="container mt-4">

    <h2>Monthly Budgets</h2>

    <p>Manage your monthly budgets.</p>

    <a asp-controller="Budget"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Add Budget
    </a>

    @if (Model.Any())
    {
        <table class="table table-striped table-bordered">

            <thead class="table-dark">
                <tr>
                    <th>Month</th>
                    <th>Year</th>
                    <th>Amount</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var budget in Model)
                {
                    <tr>
                        <td>
                            @System.Globalization.CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetMonthName(budget.Month)
                        </td>

                        <td>@budget.Year</td>

                        <td>@budget.Amount.ToString("N2") kr</td>

                        <td>
                            <a asp-controller="Budget"
                               asp-action="Edit"
                               asp-route-id="@budget.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <form asp-controller="Budget"
                                  asp-action="Delete"
                                  asp-route-id="@budget.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this budget?');">

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }
    else
    {
        <div class="alert alert-info">
            No budgets registered yet.
        </div>
    }

</div>
