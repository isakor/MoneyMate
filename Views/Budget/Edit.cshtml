
@model MoneyMate.Models.Budget

@{
    ViewData["Title"] = "Edit Budget";
}

<div class="container mt-4">

    <h2>Edit Monthly Budget</h2>

    <p>Update your monthly budget.</p>

    <form asp-controller="Budget"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        <input type="hidden" asp-for="Id" />

        <!-- Validation message -->
        <div id="validationMessage"
             asp-validation-summary="ModelOnly"
             class="text-danger"
             role="alert">
        </div>

        <!-- Budget amount -->
        <div class="mb-3">
            <label asp-for="Amount"
                   class="form-label">
                Budget Amount (kr)
            </label>

            <input asp-for="Amount"
                   type="number"
                   step="0.01"
                   min="0.01"
                   class="form-control" />

            <span asp-validation-for="Amount"
                  class="text-danger"></span>
        </div>

        <!-- Month -->
        <div class="mb-3">
            <label asp-for="Month"
                   class="form-label">
                Month
            </label>

            <select asp-for="Month"
                    class="form-select">

                @for (int month = 1; month <= 12; month++)
                {
                    <option value="@month">
                        @System.Globalization.CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetMonthName(month)
                    </option>
                }

            </select>

            <span asp-validation-for="Month"
                  class="text-danger"></span>
        </div>

        <!-- Year -->
        <div class="mb-3">
            <label asp-for="Year"
                   class="form-label">
                Year
            </label>

            <input asp-for="Year"
                   type="number"
                   min="2000"
                   max="2100"
                   class="form-control" />

            <span asp-validation-for="Year"
                  class="text-danger"></span>
        </div>

        <!-- Buttons -->
        <button type="submit"
                class="btn btn-success">
            Save Changes
        </button>

        <a asp-controller="Budget"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const message = document.getElementById("validationMessage");

            if (message) {

                // Remove bullet point
                const list = message.querySelector("ul");

                if (list) {
                    list.classList.add("list-unstyled");
                }

                // Hide validation message after 5 seconds
                if (message.textContent.trim() !== "") {
                    setTimeout(function () {
                        message.classList.add("d-none");
                    }, 5000);
                }
            }

        });
    </script>
}
