
@model MoneyMate.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    // Calculate budget percentage
    var budgetPercentage = Model.MonthlyBudget > 0
        ? Math.Min(
            Model.SpentThisMonth / Model.MonthlyBudget * 100,
            100)
        : 0;

    // Choose progress bar color
    var progressBarColor = Model.SpentThisMonth > Model.MonthlyBudget
        ? "bg-danger"
        : "bg-success";
}

<div class="container mt-4">

    <h2>Dashboard</h2>

    <p class="text-muted">
        Welcome to MoneyMate! Here is an overview of your finances.
    </p>

    <!-- Dashboard Filters -->
    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title">
                Filter Dashboard
            </h5>

            <form asp-controller="Home"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- Month -->
                    <div class="col-12 col-md-6">

                        <label for="selectedMonth"
                               class="form-label">
                            Month
                        </label>

                        <select name="selectedMonth"
                                id="selectedMonth"
                                class="form-select">

                            @for (int month = 1; month <= 12; month++)
                            {
                                if (Model.SelectedMonth == month)
                                {
                                    <option value="@month" selected>
                                        @System.Globalization.CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetMonthName(month)
                                    </option>
                                }
                                else
                                {
                                    <option value="@month">
                                        @System.Globalization.CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetMonthName(month)
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Year -->
                    <div class="col-12 col-md-6">

                        <label for="selectedYear"
                               class="form-label">
                            Year
                        </label>

                        <select name="selectedYear"
                                id="selectedYear"
                                class="form-select">

                            @foreach (var year in Model.Years)
                            {
                                if (Model.SelectedYear == year)
                                {
                                    <option value="@year" selected>
                                        @year
                                    </option>
                                }
                                else
                                {
                                    <option value="@year">
                                        @year
                                    </option>
                                }
                            }

                        </select>

                    </div>

                </div>

                <!-- Filter buttons -->
                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Filter
                    </button>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Reset
                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- Financial Summary -->
    <div class="row mb-4">

        <!-- Total Income -->
        <div class="col-md-4 mb-3">

            <div class="card border-success h-100">

                <div class="card-body">

                    <h5 class="card-title text-success">
                        Total Income
                    </h5>

                    <h3>
                        @Model.TotalIncome.ToString("N2") kr
                    </h3>

                </div>

            </div>

        </div>

        <!-- Total Expenses -->
        <div class="col-md-4 mb-3">

            <div class="card border-danger h-100">

                <div class="card-body">

                    <h5 class="card-title text-danger">
                        Total Expenses
                    </h5>

                    <h3>
                        @Model.TotalExpenses.ToString("N2") kr
                    </h3>

                </div>

            </div>

        </div>

        <!-- Balance -->
        <div class="col-md-4 mb-3">

            <div class="card border-primary h-100">

                <div class="card-body">

                    <h5 class="card-title text-primary">
                        Balance
                    </h5>

                    <h3 class="@(Model.Balance < 0 ? "text-danger" : "text-success")">
                        @Model.Balance.ToString("N2") kr
                    </h3>

                </div>

            </div>

        </div>

    </div>

    <!-- Monthly Budget -->
    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title">
                Monthly Budget
            </h5>

            @if (Model.HasMonthlyBudget)
            {
                <p>
                    Budget:
                    <strong>
                        @Model.MonthlyBudget.ToString("N2") kr
                    </strong>
                </p>

                <p>
                    Spent this month:
                    <strong>
                        @Model.SpentThisMonth.ToString("N2") kr
                    </strong>
                </p>

                <p>
                    Remaining:
                    <strong class="@(Model.RemainingBudget < 0 ? "text-danger" : "text-success")">
                        @Model.RemainingBudget.ToString("N2") kr
                    </strong>
                </p>

                <div class="progress mb-3">

                    <div class="progress-bar @progressBarColor"
                         role="progressbar"
                         style="width: @(budgetPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%"
                         aria-valuenow="@budgetPercentage"
                         aria-valuemin="0"
                         aria-valuemax="100">

                        @budgetPercentage.ToString("N0")%

                    </div>

                </div>

                @if (Model.RemainingBudget < 0)
                {
                    <div class="alert alert-danger">
                        You have exceeded your monthly budget!
                    </div>
                }
            }
            else
            {
                <p class="text-muted">
                    No budget has been set for this month.
                </p>

                <a asp-controller="Budget"
                   asp-action="Create"
                   class="btn btn-primary">
                    Create Budget
                </a>
            }

        </div>

    </div>

    <!-- Expenses by Category -->
    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title">
                Expenses by Category
            </h5>

            @if (Model.ExpensesByCategory.Any())
            {
                <!-- Category Table -->
                <div class="table-responsive">

                    <table class="table table-striped">

                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Amount</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var category in Model.ExpensesByCategory
                                .OrderByDescending(c => c.Value))
                            {
                                <tr>

                                    <td>
                                        @category.Key
                                    </td>

                                    <td class="text-danger">
                                        @category.Value.ToString("N2") kr
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- Expenses by Category Pie Chart -->
                <div class="row justify-content-center mt-4">

                    <div class="col-md-6">

                        <canvas id="categoryChart"></canvas>

                    </div>

                </div>
            }
            else
            {
                <p class="text-muted">
                    No expenses have been registered for this period.
                </p>
            }

        </div>

    </div>

    <!-- Monthly Income vs Expenses Chart -->
    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title">
                Monthly Income vs Expenses (@Model.SelectedYear)
            </h5>

            <p class="text-muted">
                Compare your income and expenses for each month.
            </p>

            <canvas id="monthlyChart"></canvas>

        </div>

    </div>

    <!-- Recent Transactions -->
    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title">
                Recent Transactions
            </h5>

            @if (Model.RecentTransactions.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped table-bordered">

                        <thead class="table-dark">

                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Amount</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var transaction in Model.RecentTransactions)
                            {
                                <tr>

                                    <!-- Date -->
                                    <td>
                                        @transaction.Date.ToString(
                                            "dd MMM yyyy",
                                            System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                    </td>

                                    <!-- Description -->
                                    <td>
                                        @transaction.Description
                                    </td>

                                    <!-- Category -->
                                    <td>
                                        @transaction.Category
                                    </td>

                                    <!-- Type -->
                                    <td>
                                        @if (transaction.Type == "Income")
                                        {
                                            <span class="badge bg-success">
                                                Income
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Expense
                                            </span>
                                        }
                                    </td>

                                    <!-- Amount -->
                                    <td class="@(transaction.Type == "Income" ? "text-success" : "text-danger")">
                                        @(transaction.Type == "Income" ? "+" : "-")@transaction.Amount.ToString("N2") kr
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <a asp-controller="Transaction"
                   asp-action="Index"
                   class="btn btn-primary">
                    View All Transactions
                </a>
            }
            else
            {
                <p class="text-muted">
                    No transactions found for the selected period.
                </p>

                <a asp-controller="Transaction"
                   asp-action="Create"
                   class="btn btn-success">
                    Add Transaction
                </a>
            }

        </div>

    </div>

</div>

@section Scripts {

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Monthly Income vs Expenses

            const monthLabels = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels)
            );

            const monthlyIncome = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(Model.MonthlyIncome)
            );

            const monthlyExpenses = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(Model.MonthlyExpenses)
            );

            const monthlyChartElement =
                document.getElementById("monthlyChart");

            // Create bar chart
            new Chart(monthlyChartElement, {

                type: "bar",

                data: {
                    labels: monthLabels,

                    datasets: [
                        {
                            label: "Income",
                            data: monthlyIncome,
                            backgroundColor: "rgba(25, 135, 84, 0.7)"
                        },
                        {
                            label: "Expenses",
                            data: monthlyExpenses,
                            backgroundColor: "rgba(220, 53, 69, 0.7)"
                        }
                    ]
                },

                options: {
                    responsive: true,

                    plugins: {
                        legend: {
                            position: "top"
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true,

                            ticks: {
                                callback: function (value) {
                                    return value.toLocaleString("nb-NO") + " kr";
                                }
                            }
                        }
                    }
                }

            });

            // Expenses by Category Pie Chart

            const categoryLabels = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.ExpensesByCategory.Keys
                )
            );

            const categoryAmounts = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.ExpensesByCategory.Values
                )
            );

            const categoryChartElement =
                document.getElementById("categoryChart");

            // Create pie chart if expenses exist
            if (categoryChartElement) {

                new Chart(categoryChartElement, {

                    type: "pie",

                    data: {
                        labels: categoryLabels,

                        datasets: [
                            {
                                data: categoryAmounts,

                                backgroundColor: [
                                    "#0d6efd",
                                    "#198754",
                                    "#dc3545",
                                    "#ffc107",
                                    "#6f42c1",
                                    "#0dcaf0",
                                    "#fd7e14",
                                    "#6c757d"
                                ]
                            }
                        ]
                    },

                    options: {
                        responsive: true,

                        plugins: {
                            legend: {
                                position: "bottom"
                            }
                        }
                    }

                });

            }

        });
    </script>
}
